# Copper Athletic Club: environment variables
#
# Copy to .env.local for local work, and set the same three in the Vercel
# project (Settings > Environment Variables) for the deployed site.
#
# Nothing here is optional-with-a-fallback. Until all three are set,
# app/api/inquiry/route.ts answers 503 not_configured on purpose and the form
# hands off to the visitor's email app instead. That is deliberate: a form
# that reports success without delivering anything is worse than no form.

# ---------------------------------------------------------------------------
# Enquiry form delivery (used by /reserve and /contact)
# ---------------------------------------------------------------------------

# Resend API key. https://resend.com > API Keys.
RESEND_API_KEY=

# The From address. This has to live on a domain verified in Resend, which
# means DNS records on that domain.
#
# IMPORTANT, and the reason this is worth reading twice: we do not control
# copperac.com's DNS, the client does. Do not block on them. Verify
# glazedweb.com in Resend instead and send from an address on it, e.g.
# copper@glazedweb.com. The route sets reply_to to the customer's own address,
# so the club hits reply and the reply goes straight to the customer. No client
# DNS work needed, and the same verified domain covers every site we build.
INQUIRY_FROM=

# Where enquiries land. Defaults to SITE.email if unset, which is
# reserve@copperac.com — the club's monitored inbox, confirmed by the owner
# (Aug 2026). Only set this to override that default.
INQUIRY_TO=

# ---------------------------------------------------------------------------
# Online ordering (/order and /kitchen)
# ---------------------------------------------------------------------------

# Postgres for orders and the 86 board. One click in Vercel: project >
# Storage > Create Database > Neon (free tier), which injects DATABASE_URL
# automatically. Without it the system falls back to in-memory storage:
# fine for local dev, NOT fine deployed. On serverless, an order placed on
# one lambda can be invisible to a kitchen screen on another, and the
# kitchen page shows a warning banner saying so.
DATABASE_URL=

# Kitchen screen PIN. Falls back to 0133 (the street number) for the demo,
# which is a PLACEHOLDER, not a secret. Set a real one before real staff
# use the board.
KITCHEN_PIN=

# Payments are OFF until this is set: checkout runs in demo mode, places
# the order without charging, and says so on the pay button. Live wiring is
# Stripe Connect with the bar as merchant of record and a 49 cent
# application fee per order (the other 50 cents of the 99 cent order fee
# stays in the bar's own Stripe account; the split needs no rebate). The
# seam is marked PAYMENT SEAM in app/api/ordering/order/route.ts.
STRIPE_SECRET_KEY=
# The bar's connected account id (acct_...), once they finish Stripe
# hosted onboarding.
STRIPE_CONNECTED_ACCOUNT=

# Keeps ordering open around the clock so the pitch works at any hour. Set to
# 1 on the demo deployment ONLY. Removing this is on the go-live checklist:
# real guests must get the real hours.
ORDERING_DEMO_ALWAYS_OPEN=

# Cloud printers, one JSON array. Each printer is configured on the bench
# (its web config page) to poll:
#   https://<host>/api/printer?token=<its token>
# role picks the template: "kitchen" prints the pass ticket (items, mods,
# flags, no money), "front" prints the handoff slip (totals, PAID ONLINE or
# DUE AT PICKUP with tip and signature lines). A successful kitchen print
# auto-accepts the order. Tokens are per-device secrets: long and random.
# Example:
# ORDERING_PRINTERS=[{"id":"kitchen1","token":"REPLACE-LONG-RANDOM","role":"kitchen","label":"Kitchen"},{"id":"front1","token":"REPLACE-LONG-RANDOM-2","role":"front","label":"Front of house"}]
ORDERING_PRINTERS=
